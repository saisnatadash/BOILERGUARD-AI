# Copy to .env and adjust. Never commit real secrets.

# --- Backend (FastAPI) ---------------------------------------------------
# Local SQLite (default when DATABASE_URL is unset):
# DATABASE_URL=sqlite:///./data/boilerguard.db
# PostgreSQL (used by docker-compose):
DATABASE_URL=postgresql+psycopg://boilerguard:boilerguard-local@localhost:5432/boilerguard

# Generate a long random value, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=480

CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=./data/uploads
REPORT_DIR=./data/reports
MAX_UPLOAD_MB=10
MAX_CSV_ROWS=5000

# Load the labelled demonstration dataset on first start (only when the database is empty).
SEED_DEMO_ON_START=true

# Demonstration engineering parameters. Replace with plant-approved values.
CHANGE_FLAG_MM=0.2
MEASUREMENT_UNCERTAINTY_MM=0.1
CRITICAL_MARGIN_RATIO=1.10
STALE_INSPECTION_DAYS=365

# --- Frontend (Next.js) ----------------------------------------------------
# Public URL of the API as seen by the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Docker Compose database ----------------------------------------------
POSTGRES_USER=boilerguard
POSTGRES_PASSWORD=boilerguard-local
POSTGRES_DB=boilerguard
